DISTRO=debian
VERSION=curl -sL https://cdimage.debian.org/debian-cd/current/amd64/iso-dvd/ | grep -oP '(?<=href=")[^"]+' | tail -n1 | sed 's/\.iso//'
DOWNLOAD=https://gemmei.ftp.acc.umu.se/debian-cd/current/amd64/iso-dvd/version.iso
SAVEAS=isos/debian.iso
CHEKSUM=curl -sL https://cdimage.debian.org/debian-cd/current/amd64/iso-dvd/SHA512SUMS | head -n 1 | awk '{printf $1}'
CHEKSUM_TYPE=sha512sum